# JYDB Text-to-SQL environment template
# Copy this file to .env, then fill the API keys and database credentials you need.

# Agent model defaults:
# - default/deepseek: deepseek/deepseek-v4-flash
# - kimi: kimi-k2.6
# - qwen: qwen3.6-plus
# - gpt: gpt-5.5
# - claude: claude-opus-4-7
# - glm/zhipu: glm-5.1
# - gemini: gemini/gemini-3.1-pro-preview

DEEPSEEK_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DASHSCOPE_API_KEY=""
MOONSHOT_API_KEY=""
ZHIPU_API_KEY=""
GEMINI_API_KEY=""

# Optional aliases. Fill either the primary key above or its alias below.
QWEN_API_KEY=""
KIMI_API_KEY=""
BIGMODEL_API_KEY=""
GLM_API_KEY=""
GOOGLE_API_KEY=""

# Optional custom base URLs. Defaults are used when left empty.
DEEPSEEK_API_BASE=""
OPENAI_API_BASE=""
ANTHROPIC_API_BASE=""
DASHSCOPE_API_BASE="https://dashscope.aliyuncs.com/compatible-mode/v1"
MOONSHOT_API_BASE="https://api.moonshot.cn/v1"
ZHIPU_API_BASE="https://open.bigmodel.cn/api/paas/v4"
GEMINI_API_BASE=""

# Evaluation/judge models.
VAR_EXTRACT_MODEL="deepseek/deepseek-v4-pro"
TEXT_JUDGE_MODEL="gpt-5.5"
VISION_CHECKLIST_MODEL="gpt-5.5"
VISION_JUDGE_MODEL="gpt-5.5"

# JYDB database credentials.
DB_HOST=""
DB_PORT=""
DB_USER=""
DB_PASSWORD=""
DB_NAME=""
